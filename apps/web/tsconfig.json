{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "plugins": [{ "name": "next" }],
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts",
    "next.config.ts",
    "App.tsx"
  ],
  "exclude": ["node_modules"]
}
