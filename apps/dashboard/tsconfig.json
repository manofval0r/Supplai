{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "jsx": "react-jsx",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2023", "DOM"]
  },
  "include": [
  "next-env.d.ts",
  "app/**/*.ts",
  "app/**/*.tsx",
  "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "next.config.ts",
    "../../fixtures/**/*.json"
  ]
}
