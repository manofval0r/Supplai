{
  "expo": {
    "name": "Supplai",
    "slug": "supplai",
    "version": "0.1.0",
    "scheme": "supplai",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supplai.app"
    },
    "android": {
      "package": "com.supplai.app",
      "adaptiveIcon": {
        "backgroundColor": "#1558C9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-notifications",
      "expo-font",
      "expo-asset",
      "./plugins/withProguardRules.js"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "db127b8e-a89d-47b1-8d84-8986e5e19cd5"
      }
    },
    "owner": "manofval0r",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/db127b8e-a89d-47b1-8d84-8986e5e19cd5"
    }
  }
}
